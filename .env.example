# ---------------------------------------------------------------------------
# Supabase (conta NOVA do Photoon SaaS - nao reaproveitar a conta antiga)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Somente server-side. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Multi-tenant / dominios
# ---------------------------------------------------------------------------
# Dominio raiz do SaaS. Os lojistas ficam em <slug>.photoon.com.br
NEXT_PUBLIC_ROOT_DOMAIN=photoon.com.br
# Protocolo usado ao montar URLs absolutas (http em dev, https em producao)
NEXT_PUBLIC_PROTOCOL=https
# Em desenvolvimento local use: lojista.localhost:3000
# NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# NEXT_PUBLIC_PROTOCOL=http

# Slug usado quando o host nao tem subdominio - acesso por IP cru ou preview.
# Vazio = sem fallback (recomendado em producao, depois que o DNS propagar).
DEFAULT_TENANT_SLUG=demo
