{
	email fabio.digital@icloud.com

	# O Caddy só emite certificado para um host depois que o app confirmar
	# que existe lojista com aquele slug. Ver src/app/api/tls-check/route.ts.
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

(proxy) {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}

		# Segura a requisicao enquanto o app volta, em vez de devolver 502.
		#
		# `docker compose up -d app` para e sobe o container: por um ou dois
		# segundos nao ha ninguem escutando em app:3000, e o Caddy respondia
		# "connection refused" -> 502 a quem estivesse usando o painel. Foi
		# medido: um usuario real levou 502 em /financeiro durante um deploy, e
		# a auditoria pegou um ChunkLoadError que deixou a tela da OS em branco.
		#
		# Com isto o pior caso vira uma espera de ate 10s no lugar de um erro.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# ---------------------------------------------------------------------------
# TEMPORARIO: acesso por IP cru, sem TLS (certificado não é emitido para IP).
# Remover quando o teste terminar.
# ---------------------------------------------------------------------------
http://2.25.140.168 {
	import proxy
}

# Domínio raiz e www: certificado emitido no arranque.
photoon.com.br, www.photoon.com.br {
	import proxy
}

# Qualquer <lojista>.photoon.com.br: certificado emitido na primeira visita,
# desde que o lojista exista. Um lojista novo passa a funcionar sozinho,
# sem editar este arquivo nem reiniciar o Caddy.
https:// {
	tls {
		on_demand
	}
	import proxy
}
